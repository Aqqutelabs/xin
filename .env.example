# Database
DB_HOST=localhost
DB_NAME=lyrivers_xinng
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Application
APP_NAME=Xinng
APP_URL=https://xin.ng
APP_ENV=production

# TwitterAPI.io X account integration
TWITTERAPI_IO_API_KEY=
# Optional shared residential proxy, e.g. http://user:password@host:port
TWITTERAPI_IO_DEFAULT_PROXY=
X_TOKEN_ENCRYPTION_KEY=generate-a-long-random-secret

# Optional X API bearer token for creator lookup
X_API_BEARER_TOKEN=
# Google Analytics 4 measurement ID used by the shared site-wide analytics tag.
GOOGLE_ANALYTICS_ID=G-FC783XQGWT

# Manual bank transfers. Leave the bank name or account number empty to disable receipt submission.
BANK_TRANSFER_BANK_NAME=Optimus Bank
BANK_TRANSFER_ACCOUNT_NAME=Aqqute Labs Ltd.
BANK_TRANSFER_ACCOUNT_NUMBER=1000325795
